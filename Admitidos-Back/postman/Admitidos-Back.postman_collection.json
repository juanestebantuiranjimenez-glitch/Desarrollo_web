    {
      "name": "Estudiantes",
      "description": "El registro público crea la cuenta y deja el token del estudiante. Las escrituras de administración usan adminToken.",
      "item": [
        {
          "name": "Registro de estudiante (público)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{url}}/auth/register/estudiante",
              "host": [
                "{{url}}"
              ],
              "path": [
                "auth",
                "register",
                "estudiante"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"tipoDocumento\": \"CC\",\n    \"numeroDocumento\": \"{{estudianteDocumento}}\",\n    \"nombres\": \"Sofía\",\n    \"apellidos\": \"Martínez Ríos\",\n    \"email\": \"{{estudianteEmail}}\",\n    \"telefono\": \"3005557788\",\n    \"password\": \"{{estudiantePassword}}\",\n    \"programa\": \"{{programaId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const s = Date.now();",
                  "pm.collectionVariables.set(\"estudianteEmail\", `estudiante.${s}@ucp.edu.co`);",
                  "pm.collectionVariables.set(\"estudianteDocumento\", String(s).slice(-10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const datos = pm.response.json();",
                  "pm.test('Registra al estudiante', () => pm.response.to.have.status(201));",
                  "pm.test('Devuelve un token', () => pm.expect(datos.data.token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', datos.data.token);",
                  "pm.collectionVariables.set('estudianteToken', datos.data.token);",
                  "pm.collectionVariables.set('estudianteId', datos.data.estudiante._id);",
                  "pm.collectionVariables.set('estudianteUsuarioId', datos.data.usuario.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login estudiante",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{url}}/auth/login",
              "host": [
                "{{url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{estudianteEmail}}\",\n    \"password\": \"{{estudiantePassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const datos = pm.response.json();",
                  "pm.test('Inicia sesión como estudiante', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', datos.data.token);",
                  "pm.collectionVariables.set('estudianteToken', datos.data.token);",
                  "pm.test('El rol es estudiante', () => pm.expect(datos.data.usuario.rol).to.eql('estudiante'));",
                  "pm.test('Tiene programa y facultad', () => {",
                  "  pm.expect(datos.data.estudiante.programa.nombre).to.be.a('string');",
                  "  pm.expect(datos.data.estudiante.programa.facultad.nombre).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
