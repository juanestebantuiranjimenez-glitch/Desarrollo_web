    {
      "name": "Autenticación",
      "description": "Login y registro. Los scripts guardan los tokens en las variables adminToken y estudianteToken, y dejan token apuntando al último login.",
      "item": [
        {
          "name": "Programas para registro (público)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{url}}/auth/programas",
              "host": [
                "{{url}}"
              ],
              "path": [
                "auth",
                "programas"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const datos = pm.response.json();",
                  "pm.test('Devuelve una lista de programas', () => pm.expect(datos.data).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{url}}/auth/login",
              "host": [
                "{{url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{adminEmail}}\",\n    \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const datos = pm.response.json();",
                  "pm.test('Inicia sesión como administrador', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve un token', () => pm.expect(datos.data.token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', datos.data.token);",
                  "pm.collectionVariables.set('adminToken', datos.data.token);"
                ]
              }
            }
          ]
        },
